# private build-suite staging (never shipped)
/android/repo/
*.xcframework.zip

# Local build artifacts (regenerated by Gradle/Flutter builds).
**/build/
**/.kotlin/
**/.gradle/
**/local.properties
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies

# Library lockfile — resolved per consumer, not pinned by the package.
/pubspec.lock

# Example app — generated host artifacts.
/example/ios/Flutter/ephemeral/
/example/ios/Pods/
/example/ios/.symlinks/

# Local workflow backups — never publish these.
**/*.pre-cloud.bak

# Editor / OS noise
.DS_Store
.idea/
.vscode/
*.iml
